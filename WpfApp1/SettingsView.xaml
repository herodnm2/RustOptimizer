<UserControl x:Class="WpfApp1.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid Background="#252525">
        <Border Background="#1E1E1E"
          CornerRadius="15"
          Padding="20"
          Margin="20"
          HorizontalAlignment="Left"
          VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <TextBlock Text="Hardware " Foreground="IndianRed" FontSize="18"  FontFamily="Cascadia Mono" FontWeight="ExtraBlack"/>

                <TextBlock x:Name="OsText" Foreground="White" FontSize="18" FontFamily="Cascadia Mono" FontWeight="ExtraBlack"/>
                <TextBlock x:Name="CpuText" Foreground="White" FontSize="18"  FontFamily="Cascadia Mono" FontWeight="ExtraBlack"/>
                <TextBlock x:Name="GpuText" Foreground="White" FontSize="18"  FontFamily="Cascadia Mono" FontWeight="ExtraBlack"/>
                <TextBlock x:Name="RamText" Foreground="White" FontSize="18"  FontFamily="Cascadia Mono" FontWeight="ExtraBlack"/>
                <TextBlock x:Name="RustPathText" Foreground="White" FontSize="18"  FontFamily="Cascadia Mono" FontWeight="ExtraBlack"/>


            </StackPanel>
        </Border>
    </Grid>
</UserControl>