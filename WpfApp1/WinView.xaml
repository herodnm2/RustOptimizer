<UserControl x:Class="WpfApp1.WinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="GlowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                             Background="{TemplateBinding Background}"
                             CornerRadius="10"
                             Padding="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFCFFFE"
                                                       BlurRadius="25"
                                                       ShadowDepth="0"
                                                       Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0"
                                                       Opacity="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="bg"
                                    CornerRadius="24"
                                    
                                    Background="#444"/>

                            <Ellipse x:Name="circle"
                                     Width="26"
                                     Height="26"
                                     Fill="White"
                                     Margin="2"
                                     HorizontalAlignment="Left"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- ON -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#00FFAA"/>
                                <Setter TargetName="circle" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>

                            <!-- OFF -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#444"/>
                                <Setter TargetName="circle" Property="HorizontalAlignment" Value="Left"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotifyStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="20"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#252525">

        <Border Background="#1E1E1E"
                CornerRadius="15"
                Padding="20"
                Width="260"
                Height="150"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <StackPanel>

                <TextBlock Text="Power Optimization"
           Foreground="White"
           FontSize="20"
           FontFamily="Cascadia Mono"
           FontWeight="ExtraBlack"
           MouseEnter="PowerHint_Show"
           MouseLeave="PowerHint_Hide"/>

                <TextBlock x:Name="PowerText"
                           Text="Detecting..."
                           Foreground="White"
                            FontFamily="Cascadia Mono"
                            FontWeight="ExtraBlack"
                           Margin="0,10"/>
                
                <CheckBox x:Name="PowerToggle"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="PowerToggle_Changed"
                          
                          Unchecked="PowerToggle_Changed" Height="43" Width="186"/>

            

            </StackPanel>

        </Border>
        <Border x:Name="NotifyBox"
Style="{StaticResource NotifyStyle}"
HorizontalAlignment="Center"
VerticalAlignment="Bottom"
Margin="0,0,0,20"
Width="250"
Panel.ZIndex="999">

            <TextBlock x:Name="NotifyText"
       Foreground="White"
       TextAlignment="Center"
       FontFamily="Cascadia Mono"/>

        </Border>
        <Border x:Name="HintBox"
        Background="#1E1E1E"
        CornerRadius="10"
        Padding="10"
        Width="220"
        Height="100"
        VerticalAlignment="Top"
        Opacity="0"
        HorizontalAlignment="Left"
        Margin="300,40,0,0"
        Panel.ZIndex="1000">

            <TextBlock Text="Improves performance by enabling High Performance power plan. Reduces input lag and increases FPS."
               Foreground="White"
               TextWrapping="Wrap"
               FontFamily="Cascadia Mono"/>
        </Border>
    </Grid>
</UserControl>