<UserControl x:Class="WpfApp1.RustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="GlowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="10"
                        BorderBrush="White"
                        BorderThickness="1">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                          
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0"
                                                  Opacity="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="bg"
                                    CornerRadius="24"
                                    
                                    Background="#444"/>

                            <Ellipse x:Name="circle"
                                     Width="26"
                                     Height="26"
                                     Fill="White"
                                     Margin="2"
                                     HorizontalAlignment="Left"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- ON -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#00FFAA"/>
                                <Setter TargetName="circle" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>

                            <!-- OFF -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#444"/>
                                <Setter TargetName="circle" Property="HorizontalAlignment" Value="Left"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="border"
                        Background="#2A2A2A"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,5,0,0">

                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                   VerticalAlignment="Center"/>

                              
                                <Ellipse x:Name="dot"
                                 Width="10"
                                 Height="10"
                                 Fill="Red"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Opacity="0"/>
                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                           
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>

                          
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Color="White"
                                                  Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Foreground" Value="Black"/>
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotifyStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="20"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#252525">

       
        <Border Background="#1E1E1E"
                CornerRadius="15"
                Padding="20"
                Width="250"
                Height="475"
                Margin="20,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <StackPanel>

                <TextBlock Text="Rust Presets"
                           Foreground="White"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           FontFamily="Cascadia Mono"
                           FontWeight="ExtraBlack"/>

                <RadioButton x:Name="MinRadio"
                             Content="Min (best fps)"
                             Checked="PresetChanged"
                             Style="{StaticResource ModernRadio}"
                             GroupName="PresetGroup"/>

                <RadioButton x:Name="MidRadio"
                             Content="Medium (combat)"
                             Checked="PresetChanged"
                             Style="{StaticResource ModernRadio}"
                             GroupName="PresetGroup"/>

                <RadioButton x:Name="MaxRadio"
                             Content="High (Cinema)"
                             Checked="PresetChanged"
                             Style="{StaticResource ModernRadio}"
                             GroupName="PresetGroup"/>

                <Button Content="APPLY"
                        Click="ApplyPreset_Click"
                        Style="{StaticResource GlowButton}"
                        Margin="0,20,0,0"/>

            </StackPanel>

        </Border>

      
        <Border Background="#1E1E1E"
                CornerRadius="15"
                Padding="10"
                Width="350"
                Height="250"
                Margin="0,20,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">

            <Grid>

                <Image x:Name="PreviewImage"
                       Stretch="Fill"
                       Source="/min.jpg"/>

                <TextBlock x:Name="PresetLabel"
                           Text="MIN"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"/>

            </Grid>
        </Border>

      
        <Border x:Name="NotifyBox"
                Style="{StaticResource NotifyStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Width="250"
                Panel.ZIndex="999">

            <TextBlock x:Name="NotifyText"
                       Foreground="White"
                       TextAlignment="Center"
                       FontFamily="Cascadia Mono"/>
        </Border>

       
        <Grid x:Name="ConfirmOverlay"
              Visibility="Collapsed"
              Background="#80000000"
              Panel.ZIndex="1000">

            <Border Width="300"
                    Height="160"
                    Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Rust Optimizer"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="16"/>

                    <TextBlock Text="Steam must be closed to apply settings.&#10;Close Steam now?"
                               Foreground="White"
                               Margin="0,10,0,10"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="No"
                                Width="80"
                                Margin="0,0,10,0"
                                Click="CancelCloseSteam"
                                Style="{StaticResource GlowButton}"/>

                        <Button Content="Yes"
                                Width="80"
                                Click="ConfirmCloseSteam"
                                Style="{StaticResource GlowButton}"/>

                    </StackPanel>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>
</UserControl>